---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Stox — Inventory, POS & Business Management Platform",
  description = "Stox is a multi-tenant inventory, point-of-sale, and business-management platform for retail and distribution businesses — with a built-in AI assistant, EN/AR support, and full RTL layout.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
  </body>
</html>
