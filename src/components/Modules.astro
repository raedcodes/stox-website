---
const modules = [
  "Products, Categories & Brands",
  "Multi-Location Inventory",
  "Stock Batches & Expiry Tracking",
  "Purchase Orders, Approvals & Returns",
  "Point of Sale & Sales",
  "Sales Returns",
  "Finance: Expenses & Cash Reconciliation",
  "Profit & Loss with Net Profit Reporting",
  "Multi-Language UI (English & Arabic)",
  "Split & Partial Payments (POS)",
  "Automated Low-Stock & Expiry Alerts",
  "Role-Based Approval Workflows",
  "Stock Transfers & Adjustments",
  "Customers & Suppliers (Ledgers)",
  "Staff & Role-Based Access",
  "Reporting Suite",
  "Executive Dashboard",
  "Multi-Currency & Branding",
  "AI Business Assistant (\"Ask Stox\")",
  "AI-Generated Report Insights",
  "Full RTL Layout Support",
  "Accounts Receivable / Payable Aging",
  "Barcode Generation (EAN, UPC, Code128)",
  "Role-Based Operational Dashboards",
];
---

<section id="modules" class="modules">
  <div class="wrap">
    <p class="section-label">Core Modules</p>
    <div class="grid">
      {modules.map((mod) => <div class="module">{mod}</div>)}
    </div>
  </div>
</section>

<style>
  .modules {
    background: var(--color-bg-alt);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .module {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 14px 16px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-heading);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
