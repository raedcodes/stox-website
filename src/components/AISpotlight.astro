---
const DEMO_URL = "https://www.loom.com/share/46e85d4eca024b8abdcaed85bb12856e";
---

<section id="ai" class="ai">
  <div class="wrap">
    <div class="spotlight">
      <span class="tag">New</span>
      <h2>AI-Powered Business Intelligence</h2>
      <p>
        Stox now includes <strong>"Ask Stox"</strong> — a built-in AI assistant
        that answers plain-English questions about sales, inventory, and
        finances on demand — plus AI-generated insights on every major report,
        turning raw figures into an instant, readable takeaway.
      </p>
      <a href={DEMO_URL} target="_blank" rel="noopener noreferrer" class="demo-link">
        Watch a short demo of the AI features &raquo;
      </a>
    </div>
  </div>
</section>

<style>
  .spotlight {
    background: var(--color-accent-light);
    border-left: 4px solid var(--color-accent);
    border-radius: 4px;
    padding: 36px 40px;
  }

  .tag {
    display: inline-block;
    background: var(--color-accent);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .spotlight h2 {
    font-size: 1.6rem;
    margin-bottom: 12px;
  }

  .spotlight p {
    max-width: 640px;
    margin: 0 0 16px;
    font-size: 1.02rem;
  }

  .demo-link {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .demo-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .spotlight {
      padding: 28px 24px;
    }
  }
</style>
