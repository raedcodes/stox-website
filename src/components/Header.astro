---
---

<header class="header">
  <div class="wrap header-inner">
    <a href="#top" class="logo">Stox</a>
    <nav class="nav">
      <a href="#modules">Modules</a>
      <a href="#ai">AI</a>
      <a href="#who-its-for">Who It's For</a>
      <a href="#contact" class="btn btn-primary">Get In Touch</a>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-heading);
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav a:not(.btn) {
    color: var(--color-body);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .nav a:not(.btn):hover {
    color: var(--color-accent);
  }

  .nav .btn {
    padding: 9px 18px;
  }

  @media (max-width: 640px) {
    .nav a:not(.btn) {
      display: none;
    }
  }
</style>
