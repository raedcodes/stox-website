---
const segments = [
  "Retail shops & mini-markets",
  "Pharmacies",
  "Distributors & wholesalers",
  "Multi-branch warehouse operators",
];
---

<section id="who-its-for" class="who">
  <div class="wrap">
    <p class="section-label">Who It's For</p>
    <p class="intro">
      Any business that needs real purchase-to-sale inventory tracking,
      without the implementation overhead of an enterprise system.
    </p>
    <div class="segments">
      {segments.map((s) => <span class="segment">{s}</span>)}
    </div>
  </div>
</section>

<style>
  .intro {
    max-width: 640px;
    font-size: 1.05rem;
    margin: 0 0 28px;
  }

  .segments {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .segment {
    border: 1px solid var(--color-accent-border);
    background: var(--color-accent-light);
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.92rem;
    padding: 10px 18px;
    border-radius: 999px;
  }
</style>
